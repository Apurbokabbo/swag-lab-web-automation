<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Test Suite">

    <!-- All Regression Tests -->
    <test name="Regression Tests" parallel="methods" thread-count="2">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="testcases.LoginPageTeseCase"/>
            <class name="testcases.HomePageTestCase"/>
            <class name="testcases.CartPageTestCase"/>
            <class name="testcases.MenuPageTestCase"/>
        </classes>
    </test>
</suite>