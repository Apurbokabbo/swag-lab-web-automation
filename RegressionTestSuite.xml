<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Test Suite">

    <!-- Runs every class in the "testcases" package that has a test in group "regression".
         New test classes are picked up automatically; no need to edit this file. -->
    <test name="Regression Tests" parallel="methods" thread-count="2">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="testcases"/>
        </packages>
    </test>
</suite>