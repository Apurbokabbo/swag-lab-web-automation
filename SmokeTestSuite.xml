<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Test Suite">

    <!-- All Smoke Tests -->
    <test name="Smoke Tests" parallel="methods" thread-count="2">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="testcases.LoginPageTeseCase"/>
            <class name="testcases.HomePageTestCase"/>
            <class name="testcases.CartPageTestCase"/>
            <class name="testcases.MenuPageTestCase"/>
        </classes>
    </test>
</suite>
